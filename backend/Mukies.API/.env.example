# Banco de dados PostgreSQL local (exemplo para desenvolvimento)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=mukiesdb;Username=postgres;Password=troque-esta-senha;SSL Mode=Disable

# Origens extras autorizadas no CORS, separadas por virgula.
# Em producao, inclua aqui a URL do front-end publicado.
Cors__AllowedOrigins=http://localhost:5173

# JWT: use uma chave exclusiva, com no mínimo 32 bytes, em produção.
Jwt__Key=TroquePorUmaChaveJWTLongaEExclusivaComMaisDe32Bytes
Jwt__Issuer=MukiesAPI
Jwt__Audience=MukiesFrontend
Jwt__ExpirationMinutes=480

# Opcional: cria o primeiro administrador apenas se ele ainda não existir.
InitialAdmin__Username=
InitialAdmin__Password=
