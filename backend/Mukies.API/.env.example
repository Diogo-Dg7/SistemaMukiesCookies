# Banco de dados local
ConnectionStrings__DefaultConnection=Server=SEU_COMPUTADOR\\SQLEXPRESS;Database=MukiesDb;Trusted_Connection=True;TrustServerCertificate=True;

# JWT: use uma chave exclusiva, com no mínimo 32 bytes, em produção.
Jwt__Key=TroquePorUmaChaveJWTLongaEExclusivaComMaisDe32Bytes
Jwt__Issuer=MukiesAPI
Jwt__Audience=MukiesFrontend
Jwt__ExpirationMinutes=480

# Opcional: cria o primeiro administrador apenas se ele ainda não existir.
InitialAdmin__Username=
InitialAdmin__Password=
